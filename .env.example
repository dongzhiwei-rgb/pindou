# 文件：.env.example
# 用途：提供 Linux Docker Compose 部署时的环境变量示例。
# 核心职责：声明 HTTPS、MySQL 数据库凭据、管理员令牌与 API 签名密钥；复制为 .env 后必须修改所有 CHANGE-ME 占位值。
# 版权：@董志伟-联系方式-makabak1204
# 最后修改：2026-08-24

# HTTPS 由容器内 Nginx 终止：将域名证书放到 certs/server.crt 与 certs/server.key，
# 443 提供服务，80 自动 301 跳转；无证书时 deploy-linux.sh 会拒绝启动。

# MySQL 数据库凭据（首次创建数据卷时生效，必须改成强密码）
MYSQL_ROOT_PASSWORD=CHANGE-ME-root-password
MYSQL_PASSWORD=CHANGE-ME-db-password

# 管理员令牌：用于调用 /api/admin/licenses 生成、查询、吊销商用密钥，改成随机长字符串
LICENSE_ADMIN_TOKEN=CHANGE-ME-admin-token

# 是否启用授权（生产建议 true；false 为免授权，重启后不再自动回退）
LICENSE_ENABLE_AUTH=true

# 生产强制开启「默认密钥拒绝启动」（compose 已固定为 true，无需修改）
# 检测到默认/占位管理密钥时后端直接拒绝启动，防止默认凭据上线。
SECURITY__REJECT_DEFAULT_SECRETS=true
